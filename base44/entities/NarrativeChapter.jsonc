{
  "name": "NarrativeChapter",
  "type": "object",
  "properties": {
    "chapter_code": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "discipline": {
      "type": "string"
    },
    "arc_name": {
      "type": "string"
    },
    "order_index": {
      "type": "number"
    },
    "summary": {
      "type": "string"
    },
    "content_markdown": {
      "type": "string"
    },
    "questions_count": {
      "type": "number",
      "default": 0
    },
    "cards_count": {
      "type": "number",
      "default": 0
    },
    "source_repo": {
      "type": "string"
    },
    "source_path": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "importado",
        "revisado",
        "publicado"
      ],
      "enumColors": [
        "gray",
        "blue",
        "yellow",
        "green"
      ],
      "default": "importado"
    }
  },
  "required": [
    "chapter_code",
    "title",
    "discipline"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}