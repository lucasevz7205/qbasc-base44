{
  "name": "GitHubImportLog",
  "type": "object",
  "properties": {
    "repo_full_name": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "imported_collections": {
      "type": "string"
    },
    "chapters_synced": {
      "type": "number",
      "default": 0
    },
    "documents_synced": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "sucesso",
        "parcial",
        "erro"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "default": "sucesso"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "repo_full_name",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}